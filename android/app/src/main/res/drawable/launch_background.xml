<?xml version="1.0" encoding="utf-8"?>
<!-- Native Android launch screen shown while Flutter initialises.
     Uses the primary brand colour so there is no white flash before
     the Flutter splash screen paints. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Primary brand background -->
    <item android:drawable="@color/primary_color" />
    <!-- Centred app logo -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo" />
    </item>
</layer-list>
