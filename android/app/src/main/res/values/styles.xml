<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: visible while Flutter initialises.
         Dark parent keeps status-bar icons white over the primary-colour background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Transparent status bar so the primary colour shows edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- White status-bar icons on the primary/dark background -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Normal theme: behind Flutter's UI once it has painted its first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/primary_color</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
