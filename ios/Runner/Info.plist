<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ── Build identity ─────────────────────────────────────────────────── -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>School Dynamics</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>School Dynamics</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- ── Device / OS requirements ───────────────────────────────────────── -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>13.0</string>

	<!-- ── UI / launch ────────────────────────────────────────────────────── -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── Orientations (iPhone) ──────────────────────────────────────────── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Orientations (iPad) ────────────────────────────────────────────── -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Background modes ───────────────────────────────────────────────── -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- ── Privacy – Camera ───────────────────────────────────────────────── -->
	<key>NSCameraUsageDescription</key>
	<string>School Dynamics uses the camera to scan QR codes for attendance tracking and to capture photos for student profiles, school events, and incident reports.</string>

	<!-- ── Privacy – Photo library (read) ────────────────────────────────── -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>School Dynamics needs access to your photo library so you can upload profile photos, event images, and other school-related documents.</string>

	<!-- ── Privacy – Photo library (save) ────────────────────────────────── -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>School Dynamics needs permission to save images — such as student profile photos and captured attendance records — to your photo library.</string>

	<!-- ── Privacy – Location ─────────────────────────────────────────────── -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>School Dynamics uses your location to verify teacher attendance and to support location-based school management features while the app is in use.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>School Dynamics uses your location to verify teacher attendance and to support location-based school management features, including when the app is running in the background.</string>

</dict>
</plist>
